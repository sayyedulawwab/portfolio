---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPosts, tagSlug } from '../../lib/posts';

const posts = await getPosts();
const tags = await getAllTags();

const title = 'Writing on backend engineering, architecture and databases';
const description =
  'Articles by Muhammad Sayyedul Awwab on .NET Core backend engineering, software architecture, system design, databases and performance.';
---

<BaseLayout title={title} description={description} pageUrl="/blog/">
  <div class="py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Writing</h1>
    <p class="mt-3 article text-lg leading-relaxed text-muted">
      Notes on backend engineering, software architecture, databases and the
      decisions behind them. {posts.length} articles so far.
    </p>

    {
      tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
          {tags.map(({ tag, count }) => (
            <li>
              <a
                href={`/blog/tags/${tagSlug(tag)}/`}
                class="underline underline-offset-4 hover:text-accent"
              >
                {tag} <span class="tabular-nums text-xs">({count})</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-10">
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>

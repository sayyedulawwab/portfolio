---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { info } from '../../data/info';
import {
  formatDate,
  getPosts,
  isoDate,
  readingTime,
  tagSlug,
  type Post,
} from '../../lib/posts';

interface Props {
  entry: Post;
}

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const minutes = readingTime(entry.body);
const published = entry.data.publishedOn;
const updated = entry.data.updatedOn;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.metaDescription}
  pageUrl={`/blog/${entry.id}/`}
  article={{
    publishedTime: published.toISOString(),
    modifiedTime: updated?.toISOString(),
    tags: entry.data.tags,
  }}
>
  <article class="py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/blog/" class="underline underline-offset-4 hover:text-accent">
        Writing
      </a>
    </nav>

    <header class="mt-6 article">
      <h1
        class="text-3xl sm:text-4xl font-semibold tracking-tight leading-tight text-balance"
      >
        {entry.data.title}
      </h1>

      <p class="mt-4 text-sm text-muted">
        <time datetime={isoDate(published)}>{formatDate(published)}</time>
        {' · '}{minutes} min read
        {
          updated && (
            <>
              {' · '}Updated{' '}
              <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
            </>
          )
        }
      </p>

      {
        entry.data.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
            {entry.data.tags.map(tag => (
              <li>
                <a
                  href={`/blog/tags/${tagSlug(tag)}/`}
                  class="border border-rule px-2 py-0.5 hover:text-accent"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="mt-10 prose prose-lg article
             prose-headings:font-semibold prose-headings:tracking-tight
             prose-a:text-accent prose-a:underline-offset-4
             prose-pre:border prose-pre:border-rule prose-pre:rounded-none
             prose-img:border prose-img:border-rule
             dark:prose-invert"
    >
      <Content />
    </div>

    <footer class="mt-16 border-t border-rule pt-8 article text-sm text-muted">
      <p>
        Written by {info.name}, backend software engineer in {info.location}.{' '}
        <a
          href={info.socialMedia.linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-fg underline underline-offset-4 hover:text-accent"
        >
          LinkedIn
        </a>{' · '}
        <a
          href="/rss.xml"
          class="text-fg underline underline-offset-4 hover:text-accent">RSS</a
        >
      </p>
    </footer>
  </article>
</BaseLayout>

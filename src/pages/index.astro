---
import Capabilities from '../components/Capabilities.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import RecentArticles from '../components/RecentArticles.astro';
import Testimonials from '../components/Testimonials.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title =
  'Muhammad Sayyedul Awwab — Backend Software Engineer (.NET Core)';
const description =
  'Backend software engineer in Dhaka building systems in .NET Core — APIs, SQL Server, CQRS, Clean Architecture and Domain-Driven Design — working toward software architecture and system design.';
---

<BaseLayout title={title} description={description} pageUrl="/">
  <Hero />
  <Experience />
  <Capabilities />
  <Projects />
  <RecentArticles />
  <Testimonials />
  <Contact />
</BaseLayout>

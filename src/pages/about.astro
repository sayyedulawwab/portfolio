---
import { info } from '../data/info';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description =
  'Muhammad Sayyedul Awwab — backend software engineer in Dhaka building systems in .NET Core, working toward software architecture and technical leadership.';
---

<BaseLayout title={title} description={description} pageUrl="/about/">
  <div class="py-16">
    <div class="article">
      <h1 class="text-3xl font-semibold tracking-tight">About</h1>

      <div class="mt-8 flex items-start gap-5">
        <img
          src="/assets/images/propic.jpg"
          alt="Muhammad Sayyedul Awwab"
          width="192"
          height="192"
          decoding="async"
          class="size-24 rounded-full object-cover border border-rule shrink-0"
        />
      </div>

      {
        /*
        ORIGIN — adapted from the user's own LinkedIn About. Nothing added.
        Source: "My software engineering journey began with a childhood
        fascination for computers, sparked by gaming. Using platforms like
        Google, Facebook, and YouTube fueled my curiosity about how the web
        worked and how these systems are built. During my Bachelor's, this
        curiosity evolved into a passion for a career in Software Engineering."
      */
      }
      <h2 class="mt-14 text-xl font-semibold tracking-tight">
        How I got here
      </h2>
      <div class="mt-4 space-y-5 text-[17px] leading-relaxed">
        <p>
          It started with games. I was fascinated by computers as a child, and
          the more I used things like Google, Facebook and YouTube, the more I
          wanted to know what was behind them — how the web actually worked,
          and how systems at that size get built at all. During my
          Bachelor&rsquo;s that curiosity turned into the thing I wanted to do
          for a living.
        </p>
        <p>
          I still think it is the most interesting question in the job. Every
          system I have worked on is somebody&rsquo;s answer to it, and the
          answers are never obvious.
        </p>
        <p>
          Since then I have worked on distributed platforms and on enterprise
          business systems — two fairly different shapes of problem, with
          different things to get wrong.{' '}
          <a
            href="/#experience"
            class="underline underline-offset-4 hover:text-accent"
          >
            Where and what is on the home page
          </a>.
        </p>
      </div>

      {
        /*
        DIRECTION — adapted from the user's LinkedIn "I strive to" list.
        Frontend deliberately left out per the positioning rule.
      */
      }
      <h2 class="mt-14 text-xl font-semibold tracking-tight">
        What I am working toward
      </h2>
      <ul class="mt-4 space-y-4 text-[17px] leading-relaxed">
        <li>
          <span class="font-medium">Backend depth.</span> Designing systems that
          are scalable, reliable, maintainable and performant, and getting sharper
          on the trade-offs each of those goals costs the others.
        </li>
        <li>
          <span class="font-medium">
            Software architecture and technical leadership.
          </span>{' '}
          Owning the design decisions rather than only implementing them, and guiding
          a team through them. I am not there yet; this is the direction I am deliberately
          heading in.
        </li>
        <li>
          <span class="font-medium">Sharing what I learn.</span> Through writing,
          and through helping other engineers where I can.
        </li>
      </ul>

      <h2 class="mt-14 text-xl font-semibold tracking-tight">Why I write</h2>
      <div class="mt-4 space-y-5 text-[17px] leading-relaxed">
        <p>
          Writing is how I find out whether I actually understand something. If
          I cannot explain why a decision was made and what it cost, I did not
          understand the decision. Putting it in public also means the
          reasoning can be checked by people who know more than I do.
        </p>
        <p>
          Most of what I publish is about .NET Core, architecture patterns,
          databases and performance.{' '}
          <a
            href="/blog/"
            class="underline underline-offset-4 hover:text-accent"
          >
            You can read it here
          </a>.
        </p>
      </div>

      <h2 class="mt-14 text-xl font-semibold tracking-tight">Get in touch</h2>
      <p class="mt-4 text-[17px] leading-relaxed">
        If any of this overlaps with what you are working on, I am glad to
        talk.
      </p>

      <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <a
          href="/#contact"
          class="inline-flex items-center bg-fg text-bg px-5 py-2.5 font-medium hover:opacity-90 transition-opacity"
        >
          Send me a message
        </a>
        <a
          href={info.socialMedia.linkedin.url}
          target="_blank"
          rel="noopener noreferrer me"
          class="underline underline-offset-4 hover:text-accent"
        >
          LinkedIn
        </a>
        <a
          href={info.socialMedia.github.url}
          target="_blank"
          rel="noopener noreferrer me"
          class="underline underline-offset-4 hover:text-accent"
        >
          GitHub
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

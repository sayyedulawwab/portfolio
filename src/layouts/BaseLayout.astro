---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { info } from '../data/info';

const { title, author, description, pageUrl } = Astro.props;

const canonicalUrl = `https://sayyedulawwab.com${pageUrl}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f172a"
      media="(prefers-color-scheme: dark)"
    />

    <meta name="author" content={author} />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content={new URL('/og-image.png', info.baseUrl).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL('/og-image.png', info.baseUrl).href}
    />

    <title>{title}</title>

    <!-- Person structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Muhammad Sayyedul Awwab',
        jobTitle: 'Software Engineer',
        url: canonicalUrl,
        sameAs: [
          'https://github.com/sayyedulawwab',
          'https://www.linkedin.com/in/sayyedulawwab',
          'https://medium.com/@sayyedulawwab',
        ],
        worksFor: {
          '@type': 'Organization',
          name: 'Epyllion Group',
        },
      })}
    />

    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <script
      is:inline
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-KNPHGYLQ36"></script>
  </head>
  <!-- Google tag (gtag.js) -->
  <script is:inline type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());

    gtag('config', 'G-KNPHGYLQ36');
  </script>
  <body>
    <Header />
    <main class="w-4/5 mx-auto text-lg my-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>

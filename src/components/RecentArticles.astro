---
import PostList from './PostList.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
---

<section id="writing" class="scroll-mt-20 py-16 border-t border-rule">
  <div class="flex items-baseline justify-between gap-6">
    <h2 class="text-xl font-semibold tracking-tight">Writing</h2>
    <a href="/blog/" class="text-sm underline underline-offset-4 hover:text-accent">
      All articles
    </a>
  </div>

  <p class="mt-2 article text-muted">
    Notes on architecture decisions, measurement, and the things that go wrong in
    production.
  </p>

  <div class="mt-8">
    <PostList posts={posts} headingLevel={3} />
  </div>
</section>

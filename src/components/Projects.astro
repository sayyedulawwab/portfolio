---
import { info } from '../data/info';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const titleFor = (slug: string) =>
  posts.find(post => post.id === slug)?.data.title;
---

<section id="projects" class="scroll-mt-20 py-16 border-t border-rule">
  <h2 class="text-xl font-semibold tracking-tight">Projects</h2>
  <!-- <p class="mt-2 article text-muted"></p> -->

  <ul class="mt-10 divide-y divide-rule border-y border-rule">
    {
      info.projects.map(project => (
        <li class="py-7 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-8">
          <div class="article">
            <h3 class="font-semibold">{project.title}</h3>

            <p class="mt-2 text-[15px] leading-relaxed text-muted">
              {project.description}
            </p>

            <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
              {project.built_with.map(tech => (
                <li>{tech}</li>
              ))}
            </ul>

            {project.writeups.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm border-l-2 border-rule pl-4">
                {project.writeups.map(slug => {
                  const title = titleFor(slug);
                  return title ? (
                    <li>
                      <a
                        href={`/blog/${slug}/`}
                        class="text-muted hover:text-accent underline underline-offset-4"
                      >
                        {title}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            )}
          </div>

          <p class="flex gap-4 text-sm shrink-0">
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-4 hover:text-accent"
              >
                Source
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-4 hover:text-accent"
              >
                Live
              </a>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</section>

---
import { info } from '../data/info';
---

<section id="capabilities" class="scroll-mt-20 py-16 border-t border-rule">
  <h2 class="text-xl font-semibold tracking-tight">What I work with</h2>
  <!-- <p class="mt-2 article text-muted"></p> -->

  <div class="mt-10 grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {
      info.capabilities.map(group => (
        <div>
          <h3 class="font-semibold">{group.title}</h3>
          <ul class="mt-3 text-sm">
            {group.items.map(item => (
              <li class="border-t border-rule py-1.5 flex items-baseline justify-between gap-4">
                <span>{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  {
    info.currentlyLearning.length > 0 && (
      <div class="mt-12 border-t border-rule pt-8">
        <h3 class="font-semibold">Currently learning</h3>
        <ul class="mt-3 space-y-2 text-[15px] text-muted">
          {info.currentlyLearning.map(entry => (
            <li>
              <span class="text-fg">{entry.topic}</span>
              {entry.note && <span> — {entry.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

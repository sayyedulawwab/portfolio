---
import { info } from '../data/info';

const label = (value: string) =>
  value === 'Present'
    ? 'Present'
    : new Date(`${value}-01T00:00:00`).toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric',
      });
---

<section id="experience" class="scroll-mt-20 py-16 border-t border-rule">
  <h2 class="text-xl font-semibold tracking-tight">Experience</h2>

  <ol class="mt-10 space-y-14">
    {
      info.experience.map(job => (
        <li class="grid gap-2 sm:grid-cols-[10rem_1fr] sm:gap-8">
          <p class="text-sm text-muted sm:pt-1 tabular-nums">
            <time datetime={job.startDate}>{label(job.startDate)}</time>
            {' – '}
            {job.endDate === 'Present' ? (
              'Present'
            ) : (
              <time datetime={job.endDate}>{label(job.endDate)}</time>
            )}
          </p>

          <div class="article">
            <h3 class="font-semibold">{job.position}</h3>
            <p class="text-sm text-muted">
              {job.company} · {job.location}
            </p>

            {job.context && (
              <p class="mt-3 text-[15px] leading-relaxed">{job.context}</p>
            )}

            <ul class="mt-3 space-y-2 text-[15px] leading-relaxed text-muted list-disc pl-5 marker:text-rule">
              {job.highlights.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

---
import { info } from '../data/info';
---

<section class="pt-14 pb-20 sm:pt-20 sm:pb-24">
  <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:gap-12 sm:items-start">
    <div>
      <h1
        class="article text-[1.6rem] leading-tight sm:text-[2.1rem] sm:leading-[1.2] font-semibold tracking-tight text-balance"
      >
        Hi, I&rsquo;m {info.name}.
      </h1>

      <p class="mt-3 text-sm text-muted">
        {info.role} &middot; {info.location}
      </p>
    </div>

    <img
      src="/assets/images/propic.jpg"
      alt=""
      width="160"
      height="160"
      fetchpriority="high"
      decoding="async"
      class="size-36 sm:size-40 rounded-full object-cover border border-rule order-first sm:order-0"
    />
  </div>

  <div class="article mt-8 space-y-5 text-lg leading-relaxed">
    <p>{info.positioning}</p>
    <p class="text-muted">{info.direction}</p>
    <p class="text-muted">{info.invitation}</p>
  </div>

  <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
    <a
      href="#contact"
      class="inline-flex items-center bg-fg text-bg px-5 py-2.5 font-medium hover:opacity-90 transition-opacity"
    >
      Say hello
    </a>
    <a
      href="#experience"
      class="underline underline-offset-4 hover:text-accent"
    >
      What I work on
    </a>
    <a
      href={info.resume.url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-muted underline underline-offset-4 hover:text-fg"
    >
      Résumé (PDF)
    </a>
  </div>
</section>

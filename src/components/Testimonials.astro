---
import { info } from '../data/info';
---

<section id="testimonials" class="scroll-mt-20 py-16 border-t border-rule">
  <h2 class="text-xl font-semibold tracking-tight">What colleagues say</h2>

  <div class="mt-10 grid gap-10 md:grid-cols-2">
    {
      info.recommendations.map(person => (
        <figure>
          <blockquote class="space-y-3 text-[15px] leading-relaxed text-muted">
            {person.description.map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </blockquote>

          <figcaption class="mt-4 flex items-center gap-3 border-t border-rule pt-4">
            <img
              src={person.avatar}
              alt=""
              width="36"
              height="36"
              loading="lazy"
              decoding="async"
              class="size-9 rounded-full object-cover border border-rule"
            />
            <span class="text-sm">
              <span class="font-medium block">{person.name}</span>
              <span class="text-muted">{person.headline}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

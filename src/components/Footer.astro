---
import { info } from '../data/info';

const year = new Date().getFullYear();
const links = [
  info.socialMedia.github,
  info.socialMedia.linkedin,
  info.socialMedia.medium,
  info.socialMedia.email,
];
---

<footer class="border-t border-rule mt-24">
  <div
    class="max-w-5xl mx-auto px-5 sm:px-8 py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 text-sm text-muted"
  >
    <p>&copy; {year} {info.name}</p>

    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        links.map(link => (
          <li>
            <a
              href={link.url}
              rel="noopener noreferrer me"
              target={link.url.startsWith('mailto:') ? undefined : '_blank'}
              class="hover:text-fg transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/rss.xml" class="hover:text-fg transition-colors">RSS</a>
      </li>
    </ul>
  </div>
</footer>
